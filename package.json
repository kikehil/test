{
  "name": "crm-cotizaciones",
  "version": "1.0.0",
  "description": "Sistema CRM para control de cotizaciones multi-empresa",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "migrate": "node backend/src/database/migrate.js",
    "seed": "node backend/src/database/seed.js",
    "build:css": "tailwindcss -i ./frontend/src/input.css -o ./frontend/public/css/output.css --watch",
    "postinstall": "echo 'Dependencies installed successfully'"
  },
  "keywords": ["crm", "cotizaciones", "express", "mysql"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "nodemailer": "^6.9.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.1"
  }
}

